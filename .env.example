# ─────────────────────────────────────────────────────────────────────────────
# habit-tracker · environment variables
# Copy to `.env` (git-ignored). Every variable is validated at boot by a Zod
# schema (apps/api/src/config/env.ts, apps/worker/src/config/env.ts) — a typo
# fails fast with a readable message instead of a 3 AM surprise.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# HTTP port of the API
PORT=3005
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Postgres (docker compose maps host 5433 -> container 5432) ───────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/habit_tracker
# Separate DB used by `pnpm test:integration` (created by docker/postgres/init)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/habit_tracker_test

# ── Redis: cache (L8), rate limiting (L9), BullMQ + Pub/Sub for SSE (L11) ────
REDIS_URL=redis://localhost:6380

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the API — better-auth uses it to build callback/verification links
API_URL=http://localhost:3005
# Origin of the web client — allowed by CORS (with credentials) and by better-auth
WEB_URL=http://localhost:5173

# ── Auth (L10) ───────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-32-bytes-minimum-secret
# Optional social provider. Register the OAuth app with callback URL:
#   {API_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Object storage (L12) — MinIO locally, S3/GCS in prod: same SDK ───────────
S3_ENDPOINT=http://localhost:9000
# The URL the *browser* uses for presigned uploads. Same as S3_ENDPOINT locally;
# inside docker the api reaches MinIO at http://minio:9000 but the browser still
# needs http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=habit-tracker
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Max upload size in bytes (default 5 MiB)
UPLOAD_MAX_BYTES=5242880

# How often the worker's outbox poller looks for unpublished events (ms)
OUTBOX_POLL_MS=2000

# ── Email (L11) — provider: console | smtp | resend ──────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="Habit Tracker <no-reply@habit-tracker.local>"
# Mailpit SMTP (docker compose). Inbox UI: http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Only when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ── Stripe (L12) — test mode keys from https://dashboard.stripe.com/test ─────
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3005/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Price of the "Pro" plan in the smallest currency unit (500 = $5.00)
PRO_PLAN_AMOUNT=500
PRO_PLAN_CURRENCY=usd

# ── Observability (L9) — leave empty to disable Sentry ───────────────────────
SENTRY_DSN=
# Set by CI/CD to the git SHA of the deployed build (Sentry release tagging)
GIT_SHA=

# Environment for the *containerised* api + worker (docker compose --profile app).
# Same variables as .env.example, but hostnames point at compose service names.
NODE_ENV=production
PORT=3005
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@postgres:5432/habit_tracker
REDIS_URL=redis://redis:6379
API_URL=http://localhost:3005
WEB_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-please-32-bytes-minimum-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=habit-tracker
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
UPLOAD_MAX_BYTES=5242880
EMAIL_PROVIDER=smtp
EMAIL_FROM="Habit Tracker <no-reply@habit-tracker.local>"
SMTP_URL=smtp://mailpit:1025
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRO_PLAN_AMOUNT=500
PRO_PLAN_CURRENCY=usd
SENTRY_DSN=
GIT_SHA=
